# Copier ce fichier en .env puis renseigner les valeurs (ne jamais committer .env).
# Seules les valeurs sans conséquence sont pré-remplies ; les secrets restent vides.

# development | production (défaut : production, le réglage le plus strict)
APP_ENV=

# URL de connexion PostgreSQL, ex. postgresql+psycopg2://utilisateur:motdepasse@hote:5432/base
DATABASE_URL=

# Clé de signature des jetons, 32 caractères minimum. Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optionnel : base dédiée aux tests (pytest), elle est vidée à chaque lancement.
TEST_DATABASE_URL=

# Optionnel : cookies réservés au HTTPS (défaut : true, sauf en development)
COOKIE_SECURE=
# Optionnel : en-tête HSTS, le navigateur n'utilise plus que HTTPS (défaut : true, sauf en
# development). À ne couper que si le site n'est pas servi en HTTPS.
HSTS_ACTIF=

# Optionnel : derrière nginx, nombre de proxys de confiance (1). L'adresse IP du client
# (limitation de débit, journal des refus) est alors lue dans X-Forwarded-For.
NB_PROXYS_DE_CONFIANCE=0
# Optionnel : reprendre l'en-tête X-Request-ID posé par ce proxy (true/false).
ID_REQUETE_ENTRANT_ACCEPTE=false
# Optionnel : origines supplémentaires autorisées à écrire, séparées par des virgules
# (en development : http://localhost:5173 par défaut).
ORIGINES_AUTORISEES=

# Optionnel : journalisation. Niveau par défaut : DEBUG en development, INFO sinon.
LOG_LEVEL=
# Dossier des fichiers de journal (défaut : backend/logs). Une valeur vide coupe les
# fichiers (console seule, si systemd recueille la sortie) : laisser la ligne commentée.
# LOG_DIR=/var/log/sae-salles
LOG_RETENTION_JOURS=180
LOG_RETENTION_ERREURS_JOURS=365
